{
  "entities": {
    "Shop": {
      "title": "Shop",
      "description": "Retail shop registered by a field sales executive for snack distribution.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "shopCode": { "type": "string", "description": "Unique human-readable Shop ID such as SHP-101." },
        "name": { "type": "string", "description": "Shop display name." },
        "ownerName": { "type": "string", "description": "Contact person or owner name." },
        "phone": { "type": "string", "description": "Primary phone number." },
        "secondaryPhone": { "type": "string", "description": "Optional secondary contact number." },
        "address": { "type": "string", "description": "Shop street and locality address." },
        "pinCode": { "type": "string", "description": "Postal PIN code." },
        "routeId": { "type": "string", "description": "Assigned route identifier." },
        "photoUri": { "type": "string", "description": "Local file path or URI for shop photo." },
        "latitude": { "type": "number", "description": "Captured GPS latitude." },
        "longitude": { "type": "number", "description": "Captured GPS longitude." },
        "note": { "type": "string", "description": "Notes or remarks for the shop." },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "deleted"],
          "description": "Shop lifecycle status."
        },
        "inquiryStatus": {
          "type": "string",
          "enum": ["pending_inquiry", "confirmed", "unattended", "no_order"],
          "description": "Current order inquiry status."
        },
        "enquiryDate": { "type": "string", "description": "Date of inquiry (yyyy-MM-dd)." },
        "callDate": { "type": "string", "description": "Scheduled call date (yyyy-MM-dd)." },
        "lastOrderDate": { "type": "string", "description": "Last order date (yyyy-MM-dd)." },
        "lastCallDate": { "type": "string", "description": "Last call date (yyyy-MM-dd)." },
        "confirmedPriceNotes": { "type": "string", "description": "Summary of selected products and confirmed supplier prices." },
        "mapsLink": { "type": "string", "description": "Optional Google Maps URL for the shop." },
        "addedBy": { "type": "string", "description": "Name or ID of the field executive who added the shop." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "shopCode", "name", "ownerName", "phone", "address", "pinCode", "routeId", "status", "inquiryStatus", "createdAt", "updatedAt"]
    },
    "OrderRecord": {
      "title": "OrderRecord",
      "description": "Order placed for a registered shop.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "orderCode": { "type": "string", "description": "Order identifier such as ORD-2041." },
        "shopId": { "type": "string", "description": "Firestore document ID of the shop." },
        "shopCode": { "type": "string", "description": "Human-readable Shop ID." },
        "shopName": { "type": "string", "description": "Shop display name." },
        "routeId": { "type": "string", "description": "Route identifier." },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "delivered", "rejected"],
          "description": "Order fulfillment status."
        },
        "totalAmount": { "type": "number", "description": "Total order value in INR." },
        "itemCount": { "type": "integer", "description": "Total packet count in the order." },
        "itemsSummary": { "type": "string", "description": "Compact summary of ordered products and quantities." },
        "orderDate": { "type": "string", "description": "Order date (yyyy-MM-dd)." },
        "note": { "type": "string", "description": "Optional order instructions." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "orderCode", "shopId", "shopCode", "shopName", "routeId", "status", "totalAmount", "itemCount", "itemsSummary", "orderDate", "createdAt", "updatedAt"]
    },
    "StockItem": {
      "title": "StockItem",
      "description": "Store inventory item tracked for stock alerts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "productCode": { "type": "string", "description": "SKU code such as BC100." },
        "productName": { "type": "string", "description": "Product name." },
        "packSize": { "type": "string", "description": "Pack weight such as 100g, 200g, 500g." },
        "category": { "type": "string", "description": "Snack category." },
        "quantity": { "type": "integer", "description": "Available packet count in store." },
        "minThreshold": { "type": "integer", "description": "Minimum stock threshold before alert triggers." },
        "unitPrice": { "type": "number", "description": "Unit wholesale price in INR." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "productCode", "productName", "packSize", "category", "quantity", "minThreshold", "unitPrice", "createdAt", "updatedAt"]
    },
    "OperationsMeta": {
      "title": "OperationsMeta",
      "description": "Operational counters and receivables/payables summary for the user's dashboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "shopRegTarget": { "type": "integer", "description": "Daily shop registration target." },
        "vehiclesToDispatch": { "type": "integer", "description": "Vehicles waiting for dispatch." },
        "vehiclesOnRoad": { "type": "integer", "description": "Vehicles currently out for delivery." },
        "returnsCollected": { "type": "integer", "description": "Pending order returns collected today." },
        "toCollectAmount": { "type": "number", "description": "Pending receivable amount in INR." },
        "toCollectShops": { "type": "integer", "description": "Number of shops with pending payment." },
        "toSuppliersAmount": { "type": "number", "description": "Payable amount to suppliers in INR." },
        "toSuppliersCount": { "type": "integer", "description": "Number of suppliers to pay." },
        "seeded": { "type": "boolean", "description": "Whether initial starter data has been seeded." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "shopRegTarget", "vehiclesToDispatch", "vehiclesOnRoad", "returnsCollected", "toCollectAmount", "toCollectShops", "toSuppliersAmount", "toSuppliersCount", "seeded", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Manageable wholesale product SKU with optional pack size variants and stock levels.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "productCode": { "type": "string", "description": "Catalog identifier such as PRD-00101." },
        "sku": { "type": "string", "description": "Internal SKU code such as SKU-BNC-001." },
        "barcode": { "type": "string", "description": "EAN/UPC barcode string." },
        "name": { "type": "string", "description": "Trade name of the product." },
        "category": { "type": "string", "description": "Product category classification." },
        "brand": { "type": "string", "description": "Brand affinity name." },
        "baseUnit": { "type": "string", "description": "Base weight or volume unit." },
        "sellingUnit": { "type": "string", "description": "Selling package unit type." },
        "casePack": { "type": "string", "description": "Wholesale shipper case pack description." },
        "packSize": { "type": "string", "description": "Pack size label or range." },
        "wholesalePrice": { "type": "number", "description": "Base wholesale price in INR." },
        "mrp": { "type": "number", "description": "Retail MRP in INR." },
        "stockQuantity": { "type": "integer", "description": "Available warehouse stock quantity." },
        "minThreshold": { "type": "integer", "description": "Minimum stock reorder threshold." },
        "photoUri": { "type": "string", "description": "Local file path or URI for product image." },
        "notes": { "type": "string", "description": "B2B specifications and notes." },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "draft"],
          "description": "Catalog visibility status."
        },
        "salesVelocity": { "type": "integer", "description": "Relative sales velocity score." },
        "hasVariants": { "type": "boolean", "description": "Whether multiple pack variants exist." },
        "variantsJson": { "type": "string", "description": "Serialized JSON array of ProductVariant entries." },
        "addedDate": { "type": "string", "description": "Date product was added (yyyy-MM-dd)." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "productCode", "sku", "name", "category", "wholesalePrice", "mrp", "stockQuantity", "minThreshold", "status", "hasVariants", "createdAt", "updatedAt"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Recorded shop collection receipt or supplier payout voucher.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "receiptCode": { "type": "string", "description": "Unique receipt or payout voucher code." },
        "direction": {
          "type": "string",
          "enum": ["collect", "pay_supplier"],
          "description": "Whether payment is collected from a shop or paid to a supplier."
        },
        "partyId": { "type": "string", "description": "Referenced shop ID or supplier bill ID." },
        "partyCode": { "type": "string", "description": "Human-readable shop or supplier code." },
        "partyName": { "type": "string", "description": "Shop or supplier display name." },
        "contactName": { "type": "string", "description": "Contact person or shop owner name." },
        "phone": { "type": "string", "description": "Contact phone number." },
        "invoiceRef": { "type": "string", "description": "Allocated order or supplier bill reference." },
        "amount": { "type": "number", "description": "Payment amount in INR." },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "upi", "bank", "cheque"],
          "description": "Payment instrument used."
        },
        "referenceNumber": { "type": "string", "description": "UTR, NEFT, or cheque reference." },
        "paymentDate": { "type": "string", "description": "Payment date (yyyy-MM-dd)." },
        "recordedBy": { "type": "string", "description": "Officer or staff member recording the entry." },
        "note": { "type": "string", "description": "Optional remarks or settlement note." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "receiptCode", "direction", "partyId", "partyName", "amount", "paymentMethod", "paymentDate", "createdAt", "updatedAt"]
    },
    "SupplierBill": {
      "title": "SupplierBill",
      "description": "Supplier invoice payable tracked for vendor settlements.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "supplierCode": { "type": "string", "description": "Unique supplier code such as SUP-001." },
        "supplierName": { "type": "string", "description": "Supplier business name." },
        "contactPerson": { "type": "string", "description": "Supplier contact person." },
        "phone": { "type": "string", "description": "Supplier contact phone." },
        "location": { "type": "string", "description": "Supplier hub or city." },
        "category": { "type": "string", "description": "Supply category such as Cooking Oil or Packaging." },
        "billNumber": { "type": "string", "description": "Supplier invoice or bill number." },
        "totalBilled": { "type": "number", "description": "Total bill amount in INR." },
        "paidAmount": { "type": "number", "description": "Total settled amount so far in INR." },
        "billDate": { "type": "string", "description": "Invoice issue date (yyyy-MM-dd)." },
        "dueDate": { "type": "string", "description": "Payment due date (yyyy-MM-dd)." },
        "status": {
          "type": "string",
          "enum": ["pending", "overdue", "settled"],
          "description": "Settlement status of the supplier bill."
        },
        "notes": { "type": "string", "description": "Optional supply description or remarks." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "supplierCode", "supplierName", "billNumber", "totalBilled", "paidAmount", "dueDate", "status", "createdAt", "updatedAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Registered wholesale supplier or raw material vendor profile.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "supplierCode": { "type": "string", "description": "Unique Supplier ID such as SUP-000044." },
        "name": { "type": "string", "description": "Supplier or company name." },
        "category": { "type": "string", "description": "Trade category classification." },
        "contactPerson": { "type": "string", "description": "Primary contact person name." },
        "contactRole": { "type": "string", "description": "Role or designation of primary contact." },
        "altContactPerson": { "type": "string", "description": "Optional alternative contact person." },
        "phone": { "type": "string", "description": "Primary mobile number." },
        "altPhone": { "type": "string", "description": "Optional alternative phone number." },
        "email": { "type": "string", "description": "Optional supplier email address." },
        "address": { "type": "string", "description": "Complete business address." },
        "pinCode": { "type": "string", "description": "Postal PIN code." },
        "mapsLink": { "type": "string", "description": "Google Maps URL." },
        "latitude": { "type": "number", "description": "Captured GPS latitude." },
        "longitude": { "type": "number", "description": "Captured GPS longitude." },
        "photoUri": { "type": "string", "description": "Local file path or URI for supplier facility photo." },
        "gstin": { "type": "string", "description": "GST identification number." },
        "kycVerified": { "type": "boolean", "description": "Whether KYC and tax docs are verified." },
        "creditTerms": { "type": "string", "description": "Negotiated credit period and payment terms." },
        "confirmedPriceNotes": { "type": "string", "description": "Contracted unit pricing notes." },
        "notes": { "type": "string", "description": "Internal procurement notes." },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "deleted"],
          "description": "Supplier lifecycle status."
        },
        "addedDate": { "type": "string", "description": "Date supplier was added (yyyy-MM-dd)." },
        "addedBy": { "type": "string", "description": "Agent or officer who added the supplier." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "supplierCode", "name", "category", "contactPerson", "phone", "address", "pinCode", "kycVerified", "status", "createdAt", "updatedAt"]
    },
    "DeliveryRoute": {
      "title": "DeliveryRoute",
      "description": "Delivery route configuration, assigned driver/vehicle, and ordered stop sequence.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "name": { "type": "string", "description": "Route display title." },
        "vehicle": { "type": "string", "description": "Assigned vehicle description and plate number." },
        "maxCrates": { "type": "integer", "description": "Vehicle crate capacity." },
        "driverName": { "type": "string", "description": "Assigned field driver name." },
        "driverPhone": { "type": "string", "description": "Assigned driver phone number." },
        "dispatchWindow": { "type": "string", "description": "Dispatch time window label." },
        "stagingBay": { "type": "string", "description": "Warehouse loading bay identifier." },
        "colorIndex": { "type": "integer", "description": "Palette color index for route badges and map markers." },
        "isActive": { "type": "boolean", "description": "Whether route is active for dispatch." },
        "stopOrderIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered list of shop IDs defining stop sequence along the route."
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp via FieldValue.serverTimestamp()." }
      },
      "required": ["userId", "name", "maxCrates", "colorIndex", "isActive", "stopOrderIds", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/shops/{shopId}": {
      "schema": { "$ref": "#/entities/Shop" },
      "description": "Registered shops belonging to the authenticated field user."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "Orders placed by the authenticated field user."
    },
    "/users/{userId}/stocks/{stockId}": {
      "schema": { "$ref": "#/entities/StockItem" },
      "description": "Store stock items and alert levels for the authenticated field user."
    },
    "/users/{userId}/meta/{metaId}": {
      "schema": { "$ref": "#/entities/OperationsMeta" },
      "description": "Dashboard operational counters and receivables/payables summary."
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog SKUs managed by the authenticated user."
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Shop collection receipts and supplier payouts recorded by the authenticated user."
    },
    "/users/{userId}/supplierBills/{billId}": {
      "schema": { "$ref": "#/entities/SupplierBill" },
      "description": "Supplier payable bills and settlement tracking for the authenticated user."
    },
    "/users/{userId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Registered supplier directory profiles belonging to the authenticated user."
    },
    "/users/{userId}/routes/{routeId}": {
      "schema": { "$ref": "#/entities/DeliveryRoute" },
      "description": "Delivery routes, vehicle assignments, and stop sequences belonging to the authenticated user."
    }
  }
}
