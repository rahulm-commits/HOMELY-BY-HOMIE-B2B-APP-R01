y-center text-primary group-hover:scale-105 transition-transform shrink-0"><span class="material-symbols-outlined text-[20px]">payments</span></div><span class="font-label-sm text-label-sm font-semibold text-on-surface tracking-tight text-center truncate w-full">Payments</span></button><button class="flex flex-col items-center justify-center gap-1 group py-1.5 px-1 rounded-xl hover:bg-surface-container transition-colors active:scale-95 cursor-pointer" onclick="navigateMoreOption('New Product')" type="button"><div class="w-10 h-10 rounded-full bg-primary-container text-on-primary flex items-center justify-center group-hover:scale-105 transition-transform shrink-0"><span class="material-symbols-outlined text-[20px]">add_circle</span></div><span class="font-label-sm text-label-sm font-semibold text-on-surface tracking-tight text-center truncate w-full">New Product</span></button></div></div><!-- Persistent Bottom Navigation Bar (5 tabs) --><nav class="fixed bottom-0 left-0 right-0 z-40 pb-safe bg-white border-t border-[#dfebe3] shadow-[0_-1px_8px_rgba(0,0,0,0.04)]"><div class="max-w-[390px] mx-auto h-16 px-gutter-mobile flex items-center justify-around"><a class="flex flex-col items-center justify-center min-w-[56px] h-12 text-[#556B5D] hover:text-[#005f3a] transition-colors" data-path="home" href="#" onclick="closeMoreMenu()"><span class="material-symbols-outlined text-[24px]">home</span><span class="font-label-sm text-[11px] mt-0.5">Home</span></a><a class="flex flex-col items-center justify-center min-w-[56px] h-12 text-[#556B5D] hover:text-[#005f3a] transition-colors" data-path="shops" href="#" onclick="closeMoreMenu()"><span class="material-symbols-outlined text-[24px]">storefront</span><span class="font-label-sm text-[11px] mt-0.5">Shops</span></a><a class="flex flex-col items-center justify-center min-w-[56px] h-12 text-[#556B5D] hover:text-[#005f3a] transition-colors" data-path="orders" href="#" onclick="closeMoreMenu()"><span class="material-symbols-outlined text-[24px]">receipt_long</span><span class="font-label-sm text-[11px] mt-0.5">Orders</span></a><a aria-current="page" class="flex flex-col items-center justify-center min-w-[56px] h-12 transition-colors text-[#005f3a] font-bold relative" data-path="packing" href="#" onclick="closeMoreMenu()"><span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' 1;">inventory_2</span><span class="font-label-sm text-[11px] mt-0.5">Packing</span><span class="w-1.5 h-1.5 rounded-full bg-[#005f3a] mt-0.5"></span></a><a class="flex flex-col items-center justify-center min-w-[56px] h-12 text-[#556B5D] hover:text-[#005f3a] transition-colors" data-path="transport" href="#" onclick="closeMoreMenu()"><span class="material-symbols-outlined text-[24px]">local_shipping</span><span class="font-label-sm text-[11px] mt-0.5">Transport</span></a></div></nav><script>
  // Tab Switching Functionality
  let currentActiveTab = 'consolidated';
  function switchPackingTab(tabName) {
    const tabs = ['consolidated', 'shopwise', 'printview'];
    const primaryLabel = document.getElementById('primary-btn-label');
    currentActiveTab = tabName;

    tabs.forEach(t => {
      const panel = document.getElementById(`tab-panel-${t}`);
      const btn = document.getElementById(`tab-btn-${t}`);
      if (!panel || !btn) return;
      
      if (t === tabName) {
        panel.classList.remove('hidden');
        panel.classList.add('flex');
        btn.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-sm');
        btn.classList.remove('text-on-surface-variant');
      } else {
        panel.classList.add('hidden');
        panel.classList.remove('flex');
        btn.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-sm');
        btn.classList.add('text-on-surface-variant');
      }
    });

    if (primaryLabel) {
      if (tabName === 'consolidated') {
        primaryLabel.innerText = 'Print Vehicle Packing List';
      } else if (tabName === 'shopwise') {
        primaryLabel.innerText = 'Print Batch (12 Shop Slips)';
      } else {
        primaryLabel.innerText = 'Print Full A4 Manifest';
      }
    }
  }

  function executeCurrentTabAction() {
    if (currentActiveTab === 'consolidated') {
      triggerPrintVehicleList();
    } else if (currentActiveTab === 'shopwise') {
      printAll12Slips();
    } else {
      showToast('Printing Standard A4 Warehouse Dispatch Sheet...');
    }
  }

  // Stepper Micro-interactions for Packed Quantities
  function incrementQty(btn) {
    const qtySpan = btn.parentElement.querySelector('span');
    let current = parseInt(qtySpan.innerText, 10);
    const ordered = parseInt(qtySpan.dataset.ordered, 10);
    if (current < ordered) {
      current += 5;
      qtySpan.innerText = Math.min(current, ordered);
      showToast(`Updated loaded quantity: ${qtySpan.innerText} pk`);
    }
  }

  function decrementQty(btn) {
    const qtySpan = btn.parentElement.querySelector('span');
    let current = parseInt(qtySpan.innerText, 10);
    if (current > 0) {
      current -= 5;
      qtySpan.innerText = Math.max(current, 0);
      showToast(`Quantity adjusted: ${qtySpan.innerText} pk`);
    }
  }

  // Printing Micro-Actions and Feedback
  function triggerPrintVehicleList() {
    showToast('Sending Consolidated Manifest #KC-04 to Bay #03 Thermal Printer...');
  }

  function printAll12Slips() {
    showToast('Queued 12 Shop Dispatch Slips for printing.');
  }

  function printSingleSlip(shopName, shopId) {
    showToast(`Printing individual slip for ${shopName} [${shopId}]`);
  }

  // More Navigation Menu Drawer Controls
  function openMoreMenu() {
    const drawer = document.getElementById('more-drawer');
    const backdrop = document.getElementById('more-backdrop');
    const fabIcon = document.getElementById('more-fab-icon');
    const fabBtn = document.getElementById('more-fab-btn');

    if (!drawer || !backdrop) return;

    backdrop.classList.remove('hidden');
    drawer.classList.remove('hidden');

    // Trigger reflow for smooth animation
    requestAnimationFrame(() => {
      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');
      drawer.classList.remove('opacity-0', 'translate-y-4');
      drawer.classList.add('opacity-100', 'translate-y-0');
    });

    if (fabIcon) {
      fabIcon.innerText = 'close';
    }
    if (fabBtn) {
      fabBtn.setAttribute('aria-expanded', 'true');
    }
  }

  function closeMoreMenu() {
    const drawer = document.getElementById('more-drawer');
    const backdrop = document.getElementById('more-backdrop');
    const fabIcon = document.getElementById('more-fab-icon');
    const fabBtn = document.getElementById('more-fab-btn');

    if (!drawer || !backdrop) return;

    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');
    drawer.classList.remove('opacity-100', 'translate-y-0');
    drawer.classList.add('opacity-0', 'translate-y-4');

    setTimeout(() => {
      backdrop.classList.add('hidden');
      drawer.classList.add('hidden');
    }, 280);

    if (fabIcon) {
      fabIcon.innerText = 'more_vert';
    }
    if (fabBtn) {
      fabBtn.setAttribute('aria-expanded', 'false');
    }
  }

  function toggleMoreMenu() {
    const drawer = document.getElementById('more-drawer');
    if (!drawer) return;
    const isHidden = drawer.classList.contains('hidden');
    if (isHidden) {
      openMoreMenu();
    } else {
      closeMoreMenu();
    }
  }

  function navigateMoreOption(optionName) {
    closeMoreMenu();
    showToast(`Opened ${optionName}`);
  }

  // Keyboard navigation & accessibility
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeMoreMenu();
    }
  });

  // Toast Helpers
  let toastTimer = null;
  function showToast(message) {
    const toast = document.getElementById('packing-toast');
    const msgElement = document.getElementById('toast-message');
    if (!toast || !msgElement) return;

    msgElement.innerText = message;
    toast.classList.remove('-translate-y-24', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');

    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      dismissToast();
    }, 3200);
  }

  function dismissToast() {
    const toast = document.getElementById('packing-toast');
    if (!toast) return;
    toast.classList.remove('translate-y-0', 'opacity-100');
    toast.classList.add('-translate-y-24', 'opacity-0');
  }
</script>


















<script>
function openRouteModal() {
  const sheet = document.getElementById('route-modal-sheet');
  const backdrop = document.getElementById('route-modal-backdrop');
  if (!sheet || !backdrop) return;
  backdrop.classList.remove('pointer-events-none', 'opacity-0');
  backdrop.classList.add('pointer-events-auto', 'opacity-100');
  sheet.classList.remove('pointer-events-none', 'translate-y-full');
  sheet.classList.add('pointer-events-auto', 'translate-y-0');
}

function closeRouteModal() {
  const sheet = document.getElementById('route-modal-sheet');
  const backdrop = document.getElementById('route-modal-backdrop');
  if (!sheet || !backdrop) return;
  backdrop.classList.remove('pointer-events-auto', 'opacity-100');
  backdrop.classList.add('pointer-events-none', 'opacity-0');
  sheet.classList.remove('pointer-events-auto', 'translate-y-0');
  sheet.classList.add('pointer-events-none', 'translate-y-full');
}

function selectRoute(code, name, shopCount, btnElement) {
  const badge = document.getElementById('active-route-badge');
  const routeName = document.getElementById('active-route-name');
  const routeCount = document.getElementById('active-route-count');
  if (badge) badge.innerText = code;
  if (routeName) routeName.innerText = name;
  if (routeCount) routeCount.innerText = shopCount;

  // Update active styling across options
  const modal = document.getElementById('route-modal-sheet');
  if (modal) {
    const allBtns = modal.querySelectorAll('button[onclick^="selectRoute"]');
    allBtns.forEach(b => {
      b.classList.remove('border-primary', 'bg-primary/5');
      b.classList.add('border-outline-variant/30');
      const check = b.querySelector('.route-check-icon');
      if (check) check.classList.add('opacity-0');
    });
  }
  if (btnElement) {
    btnElement.classList.remove('border-outline-variant/30');
    btnElement.classList.add('border-primary', 'bg-primary/5');
    const check = btnElement.querySelector('.route-check-icon');
    if (check) check.classList.remove('opacity-0');
  }

  closeRouteModal();
  showToast('Switched to ' + name);
}
</script>





