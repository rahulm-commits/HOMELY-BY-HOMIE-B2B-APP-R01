<!-- Fast Toast Notification -->
<div class="fixed top-20 left-1/2 -translate-x-1/2 z-50 bg-inverse-surface text-inverse-on-surface px-4 py-2 rounded-full font-label-md text-label-md shadow-xl flex items-center gap-2 transition-opacity duration-200 opacity-0 pointer-events-none" id="toast">
<span class="material-symbols-outlined text-[16px] text-primary-fixed">check_circle</span>
<span id="toast-message">Opening Onboarding Form for New Supplier</span>
</div>
