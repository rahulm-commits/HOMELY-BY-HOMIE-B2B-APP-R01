<script>
  let isPolylineVisible = true;
  let drawerExpanded = false;
  let currentEditingRouteIndex = 1;

  function selectShop(id) {
    const card = document.getElementById('shop-card-popup');
    const nameEl = document.getElementById('card-shop-name');
    const badgeEl = document.getElementById('card-shop-badge');
    const idEl = document.getElementById('card-shop-id');

    if (id === 'SHOP-000131') {
      nameEl.textContent = 'Priya Supermarket';
      badgeEl.textContent = 'Unallocated';
      badgeEl.className = 'px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm flex-shrink-0';
      idEl.textContent = 'ID: SHOP-000131 • K. G. Varghese';
    } else if (id === 'SHOP-000088') {
      nameEl.textContent = 'Annapoorna Traders';
      badgeEl.textContent = 'Route 1 (#1)';
      badgeEl.className = 'px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm flex-shrink-0';
      idEl.textContent = 'ID: SHOP-000088 • R. Pillai';
    } else {
      nameEl.textContent = 'Store Allocation Selected';
      badgeEl.textContent = 'Active Stop';
      badgeEl.className = 'px-2 py-0.5 rounded-full bg-primary text-on-primary font-label-sm text-label-sm flex-shrink-0';
      idEl.textContent = 'ID: ' + id;
    }

    card.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
    card.classList.add('translate-y-0', 'opacity-100');
  }

  function closeShopPopup() {
    const card = document.getElementById('shop-card-popup');
    card.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
    card.classList.remove('translate-y-0', 'opacity-100');
  }

  function reassignRoute(routeName) {
    const badgeEl = document.getElementById('card-shop-badge');
    badgeEl.textContent = 'Moved to ' + routeName;
    badgeEl.className = 'px-2 py-0.5 rounded-full bg-primary text-on-primary font-label-sm text-label-sm flex-shrink-0';

    const draftPill = document.getElementById('draft-pill');
    draftPill.classList.remove('hidden');
    draftPill.querySelector('span:nth-child(2)').textContent = '4 Draft Changes';
  }

  function commitChanges() {
    const draftPill = document.getElementById('draft-pill');
    draftPill.innerHTML = '<span class="material-symbols-outlined text-secondary text-[16px]">check_circle</span><span class="font-label-sm text-label-sm text-secondary">Route Synced</span>';
    setTimeout(() => {
      draftPill.classList.add('hidden');
    }, 2000);
  }

  function discardChanges() {
    const draftPill = document.getElementById('draft-pill');
    draftPill.classList.add('hidden');
  }

  function toggleMapMode() {
    const polyline = document.getElementById('route1-line');
    const btn = document.getElementById('toggle-layer');
    isPolylineVisible = !isPolylineVisible;
    if (isPolylineVisible) {
      polyline.style.display = 'block';
      btn.classList.add('text-primary');
      btn.classList.remove('text-outline');
    } else {
      polyline.style.display = 'none';
      btn.classList.remove('text-primary');
      btn.classList.add('text-outline');
    }
  }

  function filterRoute(type) {
    const pills = ['pill-all', 'pill-r1', 'pill-r2', 'pill-r3'];
    pills.forEach(p => {
      const el = document.getElementById(p);
      if (el) {
        el.classList.remove('bg-primary', 'text-on-primary');
        el.classList.add('bg-surface-container-lowest');
      }
    });

    const activeEl = document.getElementById(type === 'all' ? 'pill-all' : ('pill-' + type));
    if (activeEl) {
      activeEl.classList.add('bg-primary', 'text-on-primary');
      activeEl.classList.remove('bg-surface-container-lowest');
    }
  }

  function switchDrawerTab(tabId) {
    const views = ['unallocated', 'routes', 'missing'];
    views.forEach(v => {
      const view = document.getElementById('tab-view-' + v);
      const btn = document.getElementById('tab-btn-' + v);
      if (v === tabId) {
        view.classList.remove('hidden');
        btn.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-semibold');
        btn.classList.remove('text-on-surface-variant');
      } else {
        view.classList.add('hidden');
        btn.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-sm', 'font-semibold');
        btn.classList.add('text-on-surface-variant');
      }
    });
  }

  function toggleDrawer() {
    const arrow = document.getElementById('drawer-arrow');
    drawerExpanded = !drawerExpanded;
    if (drawerExpanded) {
      arrow.style.transform = 'rotate(180deg)';
    } else {
      arrow.style.transform = 'rotate(0deg)';
    }
  }

  let isMapFullscreen = false;
  function toggleFullscreenMap() {
    isMapFullscreen = !isMapFullscreen;
    const mapContainer = document.getElementById('map-viewport-container');
    const icon = document.getElementById('fullscreen-icon');
    const btn = document.getElementById('fullscreen-toggle-btn');
    const bottomDrawer = document.getElementById('bottom-allocation-drawer');
    const header = document.getElementById('app-header');
    const nav = document.getElementById('app-navigation');

    if (isMapFullscreen) {
      mapContainer.classList.remove('relative', 'h-[520px]');
      mapContainer.classList.add('fixed', 'inset-0', 'h-full', 'w-full', 'z-50');
      icon.textContent = 'fullscreen_exit';
      btn.title = 'Exit Full Screen';
      btn.classList.add('bg-primary', 'text-on-primary');
      btn.classList.remove('bg-surface-container-lowest', 'text-on-surface');
      if (bottomDrawer) bottomDrawer.classList.add('hidden');
      if (header) header.classList.add('hidden');
      if (nav) nav.classList.add('hidden');
    } else {
      mapContainer.classList.add('relative', 'h-[520px]');
      mapContainer.classList.remove('fixed', 'inset-0', 'h-full', 'w-full', 'z-50');
      icon.textContent = 'fullscreen';
      btn.title = 'Full Screen View';
      btn.classList.remove('bg-primary', 'text-on-primary');
      btn.classList.add('bg-surface-container-lowest', 'text-on-surface');
      if (bottomDrawer) bottomDrawer.classList.remove('hidden');
      if (header) header.classList.remove('hidden');
      if (nav) nav.classList.remove('hidden');
    }
  }

  /* Robust Edit Route Modal Controls */
  window.openEditRouteModal = function(name, vehicle, maxCrates, currentCrates, driver, phone, time, bay) {
    const modal = document.getElementById('edit-route-modal');
    const panel = document.getElementById('edit-route-modal-panel');
    if (!modal || !panel) return;

    if (name) {
      if (name.includes('1')) currentEditingRouteIndex = 1;
      else if (name.includes('2')) currentEditingRouteIndex = 2;
      else if (name.includes('3')) currentEditingRouteIndex = 3;
      
      const titleEl = document.getElementById('modal-route-title');
      const inputNameEl = document.getElementById('modal-input-route-name');
      if (titleEl) titleEl.textContent = name;
      if (inputNameEl) inputNameEl.value = name;
    }

    if (driver) {
      const driverEl = document.getElementById('modal-input-driver');
      if (driverEl) driverEl.value = driver;
    }

    if (phone) {
      const contactEl = document.getElementById('modal-input-contact');
      if (contactEl) contactEl.value = phone;
    }

    if (time) {
      const timeEl = document.getElementById('modal-input-time');
      if (timeEl) timeEl.value = time;
    }

    if (vehicle) {
      const sel = document.getElementById('modal-select-vehicle');
      if (sel) {
        for (let opt of sel.options) {
          if (opt.value.includes(vehicle.split(' (')[0]) || opt.value.includes(vehicle)) {
            opt.selected = true;
            break;
          }
        }
      }
    }

    if (bay) {
      const baySel = document.getElementById('modal-select-bay');
      if (baySel) {
        for (let opt of baySel.options) {
          if (opt.value === bay) {
            opt.selected = true;
            break;
          }
        }
      }
    }

    if (maxCrates && currentCrates) {
      const maxInt = parseInt(maxCrates);
      const currInt = parseInt(currentCrates);
      const pct = Math.round((currInt / maxInt) * 100);
      const loadEl = document.getElementById('modal-route-load');
      const progEl = document.getElementById('modal-route-progress');
      const capTextEl = document.getElementById('modal-capacity-text');
      if (loadEl) loadEl.textContent = currInt + ' / ' + maxInt + ' Crates (' + pct + '% Full)';
      if (progEl) progEl.style.width = pct + '%';
      if (capTextEl) capTextEl.textContent = maxInt + ' Crates';
    }

    modal.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
    modal.classList.add('flex', 'opacity-100');
    panel.classList.remove('translate-y-full');
    panel.classList.add('translate-y-0');
  };

  window.closeEditRouteModal = function() {
    const modal = document.getElementById('edit-route-modal');
    const panel = document.getElementById('edit-route-modal-panel');
    if (!modal || !panel) return;

    panel.classList.remove('translate-y-0');
    panel.classList.add('translate-y-full');
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0', 'pointer-events-none');
    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }, 280);
  };

  window.showSavedToast = function(title, subtitle) {
    const toast = document.getElementById('save-toast-banner');
    if (toast) {
      if (title) document.getElementById('toast-title').textContent = title;
      if (subtitle) document.getElementById('toast-subtitle').textContent = subtitle;
      toast.classList.remove('-translate-y-8', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('-translate-y-8', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 2500);
    }
  };

  window.saveRouteDetails = function() {
    const newName = document.getElementById('modal-input-route-name').value;
    const newVehicle = document.getElementById('modal-select-vehicle').value;

    // Update corresponding route card in list if exists
    const cardNameEl = document.getElementById('route-card-name-' + currentEditingRouteIndex);
    const cardVehicleEl = document.getElementById('route-card-vehicle-' + currentEditingRouteIndex);
    if (cardNameEl && newName) cardNameEl.textContent = newName;
    if (cardVehicleEl && newVehicle) cardVehicleEl.textContent = newVehicle.split(' • ')[0];

    const draftPill = document.getElementById('draft-pill');
    if (draftPill) {
      draftPill.classList.remove('hidden');
      const textSpan = draftPill.querySelector('span:nth-child(2)');
      if (textSpan) textSpan.textContent = 'Route & Driver Updated';
    }

    window.showSavedToast('Route & Driver Details Saved!', 'Allocations and corridors updated successfully.');
    window.closeEditRouteModal();
  };
</script>












