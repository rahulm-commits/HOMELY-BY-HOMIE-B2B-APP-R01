window.openRouteModal = function() {
  const backdrop = document.getElementById('route-modal-backdrop');
  const modal = document.getElementById('route-selection-modal');
  if (!backdrop || !modal) return;

  backdrop.classList.remove('hidden');
  modal.classList.remove('hidden');
  
  // Trigger animation after unhiding
  requestAnimationFrame(() => {
    backdrop.classList.remove('opacity-0');
    backdrop.classList.add('opacity-100');
    modal.classList.remove('translate-y-full');
    modal.classList.add('translate-y-0');
  });
};

window.closeRouteModal = function() {
  const backdrop = document.getElementById('route-modal-backdrop');
  const modal = document.getElementById('route-selection-modal');
  if (!backdrop || !modal) return;

  backdrop.classList.remove('opacity-100');
  backdrop.classList.add('opacity-0');
  modal.classList.remove('translate-y-0');
  modal.classList.add('translate-y-full');

  setTimeout(() => {
    backdrop.classList.add('hidden');
    modal.classList.add('hidden');
  }, 300);
};

window.selectRoute = function(routeKey, title, stopBadge, routeCode) {
  // Update Trigger Button
  const selectedTitleEl = document.getElementById('selectedRouteTitle');
  const activeBadgeEl = document.getElementById('activeRouteBadge');
  const selectedCodeEl = document.getElementById('selectedRouteCode');
  if (selectedTitleEl) selectedTitleEl.textContent = title;
  if (activeBadgeEl) activeBadgeEl.textContent = stopBadge;
  if (selectedCodeEl && routeCode) selectedCodeEl.textContent = routeCode;

  // Update Modal Highlights
  const buttons = document.querySelectorAll('.route-option-btn');
  buttons.forEach(btn => {
    const isTarget = btn.getAttribute('data-route-id') === routeKey;
    const iconWrapper = btn.querySelector('.route-item-icon');
    const titleSpan = btn.querySelector('.route-item-title');
    const badgeSpan = btn.querySelector('.route-selected-badge');
    const stopsSpan = btn.querySelector('.route-item-stops');
    const checkIcon = btn.querySelector('.route-check-icon');

    if (isTarget) {
      btn.className = 'route-option-btn w-full flex items-center justify-between p-3.5 rounded-2xl bg-[#e5f1e8] border-2 border-primary text-left active:scale-[0.99] transition-all shadow-xs';
      if (iconWrapper) iconWrapper.className = 'route-item-icon w-9 h-9 rounded-xl bg-primary text-white flex items-center justify-center shrink-0 shadow-xs';
      if (titleSpan) titleSpan.className = 'route-item-title text-[13px] font-bold text-primary truncate';
      if (badgeSpan) badgeSpan.classList.remove('hidden');
      if (stopsSpan) stopsSpan.className = 'route-item-stops px-2 py-0.5 rounded-full bg-primary-container text-white text-[11px] font-semibold';
      if (checkIcon) {
        checkIcon.classList.remove('text-transparent');
        checkIcon.classList.add('text-primary');
      }
    } else {
      btn.className = 'route-option-btn w-full flex items-center justify-between p-3.5 rounded-2xl bg-surface-container-low hover:bg-surface-container border border-surface-container/80 text-left active:scale-[0.99] transition-all';
      if (iconWrapper) iconWrapper.className = 'route-item-icon w-9 h-9 rounded-xl bg-surface-container-highest text-on-surface flex items-center justify-center shrink-0';
      if (titleSpan) titleSpan.className = 'route-item-title text-[13px] font-bold text-on-surface truncate';
      if (badgeSpan) badgeSpan.classList.add('hidden');
      if (stopsSpan) stopsSpan.className = 'route-item-stops px-2 py-0.5 rounded-full bg-surface-container-highest text-on-surface-variant text-[11px] font-semibold';
      if (checkIcon) {
        checkIcon.classList.remove('text-primary');
        checkIcon.classList.add('text-transparent');
      }
    }
  });

  // Apply Route Database updates if available
  const d = window.routeDatabase[routeKey];
  if (d) {
    const setText = (id, val) => { const el = document.getElementById(id); if (el && val !== undefined) el.textContent = val; };
    const setHTML = (id, val) => { const el = document.getElementById(id); if (el && val !== undefined) el.innerHTML = val; };

    setText('route-code-badge', d.code);
    setText('route-bay-badge', d.bay);
    setText('vehicle-model-name', d.vehicleModel);
    setText('vehicle-plate-num', d.plateNum);
    setText('vehicle-type-tag', d.typeTag);
    setText('crew-names', d.crew);
    setText('stops-progress-text', d.progressText);
    setText('stops-eta-text', d.progressEta);
    const pBar = document.getElementById('stops-progress-bar');
    if (pBar) pBar.style.width = d.progressBar;
    setText('cash-collect-text', d.cash);
    setText('next-stop-badge', d.nextStop);
    setText('map-corridor-text', d.traffic);
    setText('turn-instruction-title', d.turnTitle);
    setText('turn-instruction-sub', d.turnSub);
    setText('map-active-stop-label', d.mapActive);
    setText('map-pin-1', d.pin1);
    setText('map-pin-2', d.pin2);
    setText('map-pin-3', d.pin3);
    setText('upcoming-stop5-name', d.s5Name);
    setText('upcoming-stop5-shopid', d.s5Id);
    setText('upcoming-stop5-loc', d.s5Loc);
    setText('upcoming-stop5-order', d.s5Order);
    setHTML('upcoming-stop5-payment', d.s5Payment);
    setText('upcoming-stop6-name', d.s6Name);
    setText('upcoming-stop6-shopid', d.s6Id);
    setText('upcoming-stop6-loc', d.s6Loc);
    setText('upcoming-stop6-order', d.s6Order);
    setHTML('upcoming-stop6-payment', d.s6Payment);
    setText('remaining-corridor-text', d.corridorSchedule);
    setText('dock-nav-label', d.dockLabel);
  }

  // Smoothly close the popup after selection
  closeRouteModal();
};

window.toggleMoreMenu = function(forceState) {
  const backdrop = document.getElementById('more-backdrop');
  const strip = document.getElementById('more-horizontal-strip');
  if (!backdrop || !strip) return;
  const isOpen = !backdrop.classList.contains('hidden');
  const newState = forceState !== undefined ? forceState : !isOpen;

  if (newState) {
    backdrop.classList.remove('hidden');
    strip.classList.remove('hidden');
  } else {
    backdrop.classList.add('hidden');
    strip.classList.add('hidden');
  }
};
</script>
