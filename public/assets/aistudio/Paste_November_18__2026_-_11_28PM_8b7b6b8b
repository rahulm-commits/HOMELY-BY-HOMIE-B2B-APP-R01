<script>
  let currentShopBalance = 28500;

  function openRecordPaymentModal(shopName, shopId, amount, phone, owner) {
    currentShopBalance = parseInt(amount, 10) || 0;
    
    const sheet = document.getElementById('payment-modal-sheet');
    const backdrop = document.getElementById('payment-modal-backdrop');
    const subtitle = document.getElementById('modal-shop-subtitle');
    const outVal = document.getElementById('modal-outstanding-val');
    const shopMeta = document.getElementById('modal-shop-meta');
    const amountInput = document.getElementById('payment-amount-input');

    if (subtitle) subtitle.textContent = shopName;
    if (outVal) outVal.textContent = '₹' + currentShopBalance.toLocaleString('en-IN');
    if (shopMeta) shopMeta.textContent = shopId + ' • ' + owner;
    
    // Suggest half or default amount
    const defaultPayment = currentShopBalance > 15000 ? 15000 : currentShopBalance;
    if (amountInput) {
      amountInput.value = defaultPayment;
    }
    recalcRemaining();

    if (sheet && backdrop) {
      sheet.classList.remove('hidden');
      backdrop.classList.remove('hidden');
      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        sheet.classList.remove('translate-y-full');
      });
    }
  }

  function closeRecordPaymentModal() {
    const sheet = document.getElementById('payment-modal-sheet');
    const backdrop = document.getElementById('payment-modal-backdrop');

    if (sheet && backdrop) {
      backdrop.classList.add('opacity-0');
      sheet.classList.add('translate-y-full');
      setTimeout(() => {
        sheet.classList.add('hidden');
        backdrop.classList.add('hidden');
      }, 250);
    }
  }

  function recalcRemaining() {
    const amountInput = document.getElementById('payment-amount-input');
    const remElem = document.getElementById('remaining-calc-val');
    if (!amountInput || !remElem) return;
    
    const entered = parseInt(amountInput.value, 10) || 0;
    const remaining = Math.max(0, currentShopBalance - entered);
    remElem.textContent = '₹' + remaining.toLocaleString('en-IN');
  }

  function setQuickAmount(amt) {
    const amountInput = document.getElementById('payment-amount-input');
    if (amountInput) {
      amountInput.value = amt;
      recalcRemaining();
    }
  }

  function fillFullAmount() {
    const amountInput = document.getElementById('payment-amount-input');
    if (amountInput) {
      amountInput.value = currentShopBalance;
      recalcRemaining();
    }
  }

  function selectPayMethod(button, method) {
    document.querySelectorAll('.pay-method-pill').forEach(btn => {
      btn.classList.remove('bg-primary', 'text-on-primary', 'active-method', 'font-bold');
      btn.classList.add('bg-surface-container', 'text-on-surface', 'font-semibold');
    });
    button.classList.remove('bg-surface-container', 'text-on-surface', 'font-semibold');
    button.classList.add('bg-primary', 'text-on-primary', 'active-method', 'font-bold');
  }

  function confirmPaymentRecorded() {
    const amountInput = document.getElementById('payment-amount-input');
    const entered = amountInput ? amountInput.value : '15,000';
    closeRecordPaymentModal();

    // Show Toast
    const toast = document.getElementById('payment-toast');
